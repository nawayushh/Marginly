# Copy this file to ".env" (same folder) and edit the values.
# Never commit the real .env file.

# LM Studio's local server. Your port is 1235 (NOT the default 1234).
LM_STUDIO_BASE_URL=http://localhost:1235/v1

# The exact model ID from LM Studio. Find it by opening
#   http://localhost:1235/v1/models
# in your browser and copying the "id" value of your Qwen model.
# Leave empty until you have looked it up.
LM_STUDIO_MODEL=

# LM Studio does not check this, but the OpenAI SDK needs a value.
LM_STUDIO_API_KEY=lm-studio

# Seconds to wait for Qwen to answer before giving up.
AI_TIMEOUT_SECONDS=120
# Maximum length of Qwen's answer in tokens (thinking models also spend tokens thinking).
AI_MAX_TOKENS=4000

# SQLite database file (relative to the project root).
DATABASE_PATH=data/marginly.db

# The only website address allowed to call this API (the Vite dev server).
FRONTEND_ORIGIN=http://localhost:5173

# Largest CSV upload in bytes (1 MB).
MAX_CSV_BYTES=1000000
