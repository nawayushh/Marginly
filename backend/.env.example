# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Restaurant / Operator Defaults
RESTAURANT_NAME="The Rustic Ladle Café"
DEFAULT_CURRENCY="INR"
DEFAULT_CURRENCY_SYMBOL="₹"

# SQLite Database File Path
DATABASE_PATH="marginly.db"

# LM Studio / Local Qwen Configuration (OpenAI Compatible)
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
LM_STUDIO_MODEL="qwen2.5-7b-instruct"
LM_STUDIO_TIMEOUT_SECONDS=45.0

# Menu Engineering Calculation Thresholds
POPULARITY_FACTOR=1.0
PRICE_ALERT_THRESHOLD_PERCENT=5.0

# Google Gemini API (used for real-time mandi alerts, market insights, recipe AI)
# Get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
