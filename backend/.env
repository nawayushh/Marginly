# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Restaurant / Operator Defaults
RESTAURANT_NAME="The Rustic Ladle Café"
DEFAULT_CURRENCY="INR"
DEFAULT_CURRENCY_SYMBOL="₹"

# SQLite Database File Path
DATABASE_PATH="marginly.db"

# LM Studio / Local Qwen Configuration (OpenAI Compatible)
# LM Studio Local Inference Server URL
LM_STUDIO_BASE_URL="http://127.0.0.1:1234/v1"
LM_STUDIO_API_KEY="lm-studio"
# You can set this to whichever model identifier is loaded in LM Studio, or "default"
LM_STUDIO_MODEL="qwen2.5-7b-instruct"
LM_STUDIO_TIMEOUT_SECONDS=45.0

# Menu Engineering Calculation Thresholds
POPULARITY_FACTOR=1.0
PRICE_ALERT_THRESHOLD_PERCENT=5.0
